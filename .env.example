# ============================================================
# Travel Planner — Environment Variables Template
# Copy this file to .env and fill in your API keys
# ============================================================

# --- Unsplash (https://unsplash.com/developers) ---
# Create a free developer account, then create an application
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# --- Groq (https://console.groq.com) ---
# Sign up for free, go to API Keys section
GROQ_API_KEY=your_groq_api_key_here

# --- OpenRouter (optional fallback) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- No keys needed for these APIs ---
# REST Countries: https://restcountries.com (free, no key)
# Open-Meteo:    https://open-meteo.com    (free, no key)
# Exchange Rate: https://open.er-api.com   (free, no key)
